# Variables de Entorno - Configuración del Sistema Universitario
# COPIA este archivo como .env y configura tus valores reales

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/universidad_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=universidad_db
DB_USER=tu_usuario_db
DB_PASSWORD=tu_password_db_seguro

# JWT Secret (genera uno seguro para producción)
JWT_SECRET_KEY=tu_jwt_secret_muy_seguro_aqui_min_32_caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# IA Configuration (opcional)
OLLAMA_BASE_URL=http://localhost:11434
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2

# CORS Origins (para producción, especifica dominios exactos)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log